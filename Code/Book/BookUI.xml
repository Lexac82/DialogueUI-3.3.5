<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/..\..\Blizzard_SharedXML\UI.xsd">

    <Script file="BookUI_Component.lua"/>
    <Script file="BookUI_Atlas.lua"/>
    <Script file="BookUI.lua"/>

    <!-- Page-number button template; child fields are assigned by Lua after creation. -->
    <Button name="DUIBookPageButtonTemplate" virtual="true">
        <Size x="40" y="40"/>
        <Layers>
            <Layer level="BORDER" textureSubLevel="2">
                <Texture name="$parentBackground" setAllPoints="true"/>
            </Layer>
            <Layer level="BORDER">
                <Texture name="$parentHighlight" hidden="true" setAllPoints="true"/>
            </Layer>
            <Layer level="OVERLAY">
                <FontString name="$parentPageText"
                    inherits="DUIFont_Book_10"
                    justifyH="CENTER"
                    justifyV="MIDDLE"
                    text="1">
                    <Anchors>
                        <Anchor point="CENTER" relativeTo="$parent" relativePoint="CENTER"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
    </Button>

    <!-- Item-description widget; masking and texture slicing are omitted for WotLK. -->
    <Frame name="DUIBookItemButtonTemplate" virtual="true">
        <Size x="64" y="64"/>
        <Layers>
            <Layer level="OVERLAY">
                <FontString name="$parentItemText"
                    inherits="DUIFont_Book_10"
                    justifyH="LEFT"
                    justifyV="MIDDLE"
                    hidden="true">
                    <Anchors>
                        <Anchor point="CENTER" relativeTo="$parent" relativePoint="CENTER"/>
                    </Anchors>
                </FontString>

                <Texture name="$parentItemBorder" hidden="true">
                    <Size x="64" y="64"/>
                    <Anchors>
                        <Anchor point="LEFT" relativeTo="$parent" relativePoint="LEFT"/>
                    </Anchors>
                </Texture>
            </Layer>

            <Layer level="ARTWORK">
                <Texture name="$parentItemIcon" hidden="true">
                    <Size x="64" y="64"/>
                    <Anchors>
                        <Anchor point="CENTER"
                            relativeTo="$parentItemBorder"
                            relativePoint="CENTER"/>
                    </Anchors>
                </Texture>
            </Layer>

            <Layer level="BACKGROUND">
                <!-- Plain texture fallback: legacy clients do not support XML texture slicing. -->
                <Texture name="$parentTextBackground" hidden="true" alpha="0.4">
                    <Anchors>
                        <Anchor point="CENTER"
                            relativeTo="$parentItemText"
                            relativePoint="CENTER"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
    </Frame>

    <!-- The frame's mixin and child references are initialized by DUIBookFrame_OnLoad in Lua. -->
    <Frame name="DUIBookFrame"
        hidden="true"
        frameStrata="DIALOG"
        topLevel="true">

        <Anchors>
            <Anchor point="LEFT"
                relativeTo="UIParent"
                relativePoint="LEFT"
                x="48"/>
        </Anchors>

        <Layers>
            <Layer level="BACKGROUND" textureSubLevel="-4">
                <Texture name="$parentScreenVignette"
                    file="Interface\AddOns\DialogueUI\Art\Book\ScreenDarken.png"
                    hidden="false"/>
            </Layer>
        </Layers>

        <Frames>
            <ScrollFrame name="$parentScrollFrame">
                <ScrollChild>
                    <Frame name="$parentScrollChild">
                        <Size x="16" y="16"/>
                    </Frame>
                </ScrollChild>
            </ScrollFrame>

            <Frame name="$parentHeader" frameLevel="10">
                <Anchors>
                    <Anchor point="TOP" relativeTo="$parent" relativePoint="TOP"/>
                </Anchors>
                <Layers>
                    <Layer level="OVERLAY" textureSubLevel="4">
                        <Texture name="$parentHeaderDivider" hidden="false">
                            <Size x="768" y="64"/>
                            <Anchors>
                                <Anchor point="BOTTOM"
                                    relativeTo="DUIBookFrameScrollFrame"
                                    relativePoint="TOP"
                                    y="-6"/>
                            </Anchors>
                        </Texture>

                        <!-- HINT: The divider mask used by modern clients is intentionally omitted. -->
                    </Layer>

                    <Layer level="OVERLAY" textureSubLevel="3">
                        <Texture name="$parentHeaderScrollOverlap" hidden="true">
                            <Size x="768" y="32"/>
                            <Anchors>
                                <Anchor point="CENTER"
                                    relativeTo="DUIBookFrameScrollFrame"
                                    relativePoint="TOP"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
            </Frame>

            <Frame name="$parentFooter" frameLevel="10">
                <Layers>
                    <Layer level="OVERLAY" textureSubLevel="3">
                        <Texture name="$parentFooterDivider" hidden="true">
                            <Size x="768" y="32"/>
                            <Anchors>
                                <Anchor point="CENTER"
                                    relativeTo="DUIBookFrameScrollFrame"
                                    relativePoint="BOTTOM"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
            </Frame>

            <!-- No debug overlay is included in the production template. -->
            <Frame name="$parentContentFrame"/>
        </Frames>

        <Scripts>
            <OnLoad>
                DUIBookFrame_OnLoad(self);
            </OnLoad>
        </Scripts>
    </Frame>
</Ui>
