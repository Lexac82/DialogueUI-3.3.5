<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/..\..\Blizzard_SharedXML\UI.xsd">

    <Script file="Skimmer_Base.lua"/>
    <Script file="Skimmer_Template.lua"/>
    <Script file="Skimmer_UI.lua"/>

    <!-- Use a virtual template without the modern mixin attribute. -->
    <!-- The mixin is applied in Lua when the button is created. -->
    <Frame name="DUISkimmerOptionTemplate" virtual="true">
        <Size x="280" y="80"/>

        <Layers>
            <Layer level="OVERLAY">
                <!-- These names become FrameNameTitle, FrameNameDesc, FrameNameTestRewardDisplay -->
                <FontString name="$parentTitle" inherits="GameFontNormal" justifyH="LEFT" justifyV="TOP" maxLines="1">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeTo="$parent" relativePoint="TOPLEFT" x="8" y="-8"/>
                    </Anchors>
                </FontString>

                <FontString name="$parentDesc" inherits="GameFontNormalSmall" justifyH="LEFT" justifyV="TOP" spacing="2">
                    <Size x="264" y="0"/>
                    <Color r="1" g="1" b="1"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeTo="$parentTitle" relativePoint="BOTTOMLEFT" x="0" y="-4"/>
                    </Anchors>
                </FontString>

                <FontString name="$parentTestRewardDisplay" inherits="GameFontNormalSmall" justifyH="LEFT" justifyV="TOP">
                    <Size x="264" y="0"/>
                    <Color r="1" g="1" b="1"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeTo="$parentDesc" relativePoint="BOTTOMLEFT" x="0" y="-4"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
    </Frame>
</Ui>
